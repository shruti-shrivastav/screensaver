# Server
PORT=9090

# Authentication — generate a strong random secret:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_use_a_long_random_string
ACCESS_TOKEN_TTL=28800      # 8 hours in seconds
REFRESH_TOKEN_TTL=604800    # 7 days in seconds

# Gemini API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudflare Tunnel name (leave blank to disable)
CF_TUNNEL_NAME=

# Ngrok Tunnel URL (leave blank to disable, overrides Cloudflare if both are set)
NGROK_URL=

# Solver
SOLVER_MAX_TURNS=5

# Data directory (relative to v3/ or absolute)
DATA_DIR=data
