[Unit]
Description=Screensaver AI Solver Service
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/Projects/screensaver
ExecStart=%h/Projects/screensaver/.venv/bin/python run.py
Restart=on-failure
# Ensure that if we stop cleanly (exit code 0), systemd does not restart the service
RestartPreventExitStatus=0
SuccessExitStatus=0
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
